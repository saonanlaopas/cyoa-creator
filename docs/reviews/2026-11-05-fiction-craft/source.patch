+import { AUTHORING_SETTINGS_ID, AuthoringSettingsSchema, AuthoringInstructionsSchema, legacyAuthoringSettings,
+  sourceDigest, sha256, type AuthoringInstructions, type AuthoringSettings } from "@story-to-cyoa/domain";
+import { ArtifactRepository } from "./artifact-repository.js";
+import { CommandRepository } from "./command-repository.js";
+import type { StoryDatabase } from "./database.js";
+
+/** No write-on-read migration: absent legacy settings resolve OFF and retain historical content. */
+export class AuthoringInstructionsRepository {
+  constructor(private readonly database: StoryDatabase) {}
+  settings(projectId: string) {
+    if (!this.database.prepare("SELECT 1 FROM projects WHERE id=?").get(projectId)) throw new Error("Project not found");
+    const version = new ArtifactRepository(this.database).getCurrent(projectId, AUTHORING_SETTINGS_ID);
+    return { versionId: version?.id ?? null, settings: version ? AuthoringSettingsSchema.parse(version.content) : legacyAuthoringSettings() };
+  }
+  context(projectId: string): AuthoringInstructions {
+    const { versionId, settings } = this.settings(projectId), guide = settings.guide;
+    return AuthoringInstructionsSchema.parse({ schemaVersion: 1, policy: "fiction-craft-v1", settingsVersionId: versionId,
+      enabled: settings.enabled, origin: settings.origin, selectedGuide: guide ? { id: guide.id, version: guide.version, sha256: guide.sha256 } : null,
+      appliedGuide: settings.enabled ? guide : null,
+      customInstructions: new CommandRepository(this.database).listEffective(projectId).map(({ id, scope, name, instruction, position }) => ({ id, scope, name, instruction, position, sha256: sha256(instruction) })),
+    });
+  }
+  assertFresh(projectId: string, context: unknown): void {
+    if (!context || sourceDigest(context) !== sourceDigest(this.context(projectId))) throw Object.assign(new Error("authoring_instructions_stale_refresh_context"), { code: "authoring_instructions_stale", retryable: false });
+  }
+  saveInTransaction(projectId: string, settings: AuthoringSettings) {
+    return new ArtifactRepository(this.database).saveArtifactInTransaction({ projectId, artifactId: AUTHORING_SETTINGS_ID, artifactType: AUTHORING_SETTINGS_ID,
+      schema: AuthoringSettingsSchema, content: settings, markDependentsStale: false });
+  }
+}
diff --git a/packages/persistence/src/authoring-instructions-validation.ts b/packages/persistence/src/authoring-instructions-validation.ts
new file mode 100644
index 0000000..8c02054
--- /dev/null
+++ b/packages/persistence/src/authoring-instructions-validation.ts
@@ -0,0 +1,23 @@
+import { AUTHORING_SETTINGS_ID, AuthoringInstructionsSchema, AuthoringSettingsSchema, sourceDigest, sourceCanonicalJson } from "@story-to-cyoa/domain";
+/** Applies at direct writes, portable restore and history reads; never manufactures missing provenance. */
+export function validateAuthoringInstructionArtifact(row: { project_id?: string; artifact_id: string; artifact_type: string; schema_version: number; content_json: string }): void {
+  if (row.artifact_id === AUTHORING_SETTINGS_ID || row.artifact_type === AUTHORING_SETTINGS_ID) {
+    if (row.artifact_id !== AUTHORING_SETTINGS_ID || row.artifact_type !== AUTHORING_SETTINGS_ID || row.schema_version !== 1) throw new Error("authoring_settings_identity_invalid");
+    AuthoringSettingsSchema.parse(JSON.parse(row.content_json));
+  }
+  const draft = row.artifact_id.startsWith("draft-authoring-context:") || row.artifact_type === "draft-authoring-context";
+  const quick = row.artifact_id === "quick-authoring-context" || row.artifact_type === "quick-authoring-context";
+  if (!draft && !quick) return;
+  if (draft && row.artifact_type !== "draft-authoring-context" || quick && row.artifact_type !== "quick-authoring-context") throw new Error("authoring_context_identity_invalid");
+  if (row.schema_version !== 1) throw new Error("authoring_context_schema_invalid");
+  const content = JSON.parse(row.content_json);
+  const instructions = AuthoringInstructionsSchema.parse(content.authoringInstructions);
+  if (content.schemaVersion !== 1 || sourceCanonicalJson(instructions) !== sourceCanonicalJson(content.authoringInstructions)) throw new Error("authoring_context_not_closed");
+  if (row.artifact_type === "draft-authoring-context") {
+    if ((row.project_id && content.binding?.projectId !== row.project_id) || content.binding?.context?.identity?.projectId !== content.binding?.projectId || row.artifact_id !== `draft-authoring-context:${content.draftVersionId}` || !content.binding || sourceDigest(content.binding) !== content.contextFingerprint
+      || sourceCanonicalJson(content.binding.context?.authoringInstructions) !== sourceCanonicalJson(instructions)) throw new Error("draft_authoring_context_binding_invalid");
+  } else {
+    const { contextFingerprint, ...identity } = content;
+    if ((row.project_id && content.projectId !== row.project_id) || row.artifact_id !== "quick-authoring-context" || sourceDigest(identity) !== contextFingerprint) throw new Error("quick_authoring_context_binding_invalid");
+  }
+}
